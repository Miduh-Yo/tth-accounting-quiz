PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/tth_quiz?schema=public
# Bat buoc: chuoi ngau nhien >= 32 ky tu. Tao bang:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Tuỳ chọn: bật tính năng sinh câu hỏi bằng AI (Claude). Để trống thì tính năng báo chưa cấu hình.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
JWT_SECRET=
JWT_EXPIRES_HOURS=8
# Chi dat true khi chay HTTPS (production)
COOKIE_SECURE=false
# Dung cho lenh `npm run seed:super-admin -w server`.
# De trong SEED_SUPER_ADMIN_PASSWORD de he thong tu sinh mat khau ngau nhien (in ra mot lan).
SEED_SUPER_ADMIN_USERNAME=superadmin
SEED_SUPER_ADMIN_FULLNAME=Super Admin
SEED_SUPER_ADMIN_PASSWORD=
