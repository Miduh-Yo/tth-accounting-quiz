generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum RoleCode {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
}

model User {
  id                 String     @id @default(cuid())
  username           String     @unique
  passwordHash       String
  fullName           String
  email              String?    @unique
  role               RoleCode   @default(EMPLOYEE)
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false)
  failedLogins       Int        @default(0)
  lockedUntil        DateTime?
  tokenVersion       Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  questions          Question[]
  exams              Exam[]
  documents          Document[]
  attempts           Attempt[]
  groupMemberships   GroupMember[]
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  actorId    String?
  actorName  String?
  targetType String?
  targetId   String?
  detail     String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

enum QuestionType {
  SINGLE
  MULTIPLE
  TRUE_FALSE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Question {
  id          String         @id @default(cuid())
  topic       String
  type        QuestionType   @default(SINGLE)
  difficulty  Difficulty     @default(MEDIUM)
  status      QuestionStatus @default(DRAFT)
  content     String
  explanation String?
  reference   String?
  options     QuestionOption[]
  examLinks   ExamQuestion[]
  document    Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentId  String?
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([topic])
  @@index([status])
}

model QuestionOption {
  id         String   @id @default(cuid())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  position   Int
  text       String
  isCorrect  Boolean  @default(false)

  @@index([questionId])
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model Exam {
  id              String         @id @default(cuid())
  title           String
  description     String?
  durationMinutes Int
  passPercent     Int            @default(70)
  status          ExamStatus     @default(DRAFT)
  assignAll       Boolean        @default(true)
  groups          ExamGroup[]
  questions       ExamQuestion[]
  attempts        Attempt[]
  createdBy       User           @relation(fields: [createdById], references: [id])
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ExamQuestion {
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  examId     String
  question   Question @relation(fields: [questionId], references: [id])
  questionId String
  position   Int

  @@id([examId, questionId])
}

model Attempt {
  id          String          @id @default(cuid())
  exam        Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  examId      String
  user        User            @relation(fields: [userId], references: [id])
  userId      String
  startedAt   DateTime        @default(now())
  submittedAt DateTime?
  late        Boolean         @default(false)
  correct     Int?
  total       Int?
  percent     Int?
  passed      Boolean?
  answers     AttemptAnswer[]

  @@unique([examId, userId])
}

model AttemptAnswer {
  attempt     Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId   String
  questionId  String
  selectedIds String[]
  isCorrect   Boolean

  @@id([attemptId, questionId])
}

model Group {
  id        String        @id @default(cuid())
  name      String        @unique
  members   GroupMember[]
  exams     ExamGroup[]
  createdAt DateTime      @default(now())
}

model GroupMember {
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String
  user    User   @relation(fields: [userId], references: [id])
  userId  String

  @@id([groupId, userId])
}

model ExamGroup {
  exam    Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  examId  String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String

  @@id([examId, groupId])
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

model Document {
  id            String         @id @default(cuid())
  title         String
  code          String?
  url           String?
  summary       String?
  effectiveDate DateTime?
  status        DocumentStatus @default(ACTIVE)
  questions     Question[]
  createdBy     User           @relation(fields: [createdById], references: [id])
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
}
